{
  "name": "friday_fun",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server \"pnpm:dev:client\" \"pnpm:dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch --clear-screen=false --include \"server/src/**/*.ts\" --include \"shared/**/*.ts\" server/src/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "build:verify": "vite build --config client/vite.config.ts --outDir ../node_modules/.cache/build-verify --emptyOutDir --logLevel warn",
    "start:server": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "assets:backup": "tsx scripts/assets.ts backup",
    "assets:restore": "tsx scripts/assets.ts restore",
    "model": "tsx scripts/models/index.ts",
    "image": "tsx scripts/image.ts",
    "harbour": "tsx scripts/harbour.ts",
    "sounds": "node F:/Dev/Libraries/SonnisSounds/sounds.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build:verify",
    "surface": "tsx scripts/surfaces/index.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.32.0",
    "@colyseus/core": "^0.18.23",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.6",
    "@colyseus/ws-transport": "^0.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "webgpu": "^0.6.2"
  }
}
