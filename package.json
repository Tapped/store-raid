{
  "name": "friday_fun",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch --clear-screen=false --include 'server/src/**/*.ts' --include 'shared/**/*.ts' server/src/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "build:verify": "vite build --config client/vite.config.ts --outDir ../node_modules/.cache/build-verify --emptyOutDir --logLevel warn",
    "start:server": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run build:verify"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.32.0",
    "@colyseus/core": "^0.18.23",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.6",
    "@colyseus/ws-transport": "^0.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
